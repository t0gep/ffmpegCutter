<Window x:Class="ffmpegCutter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ffmpegCutter"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="ffmpeg Cutter" Height="600" Width="300"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        >
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!--メニュー-->
        <Menu Grid.Row="0">
            <MenuItem Header="ファイル">
                <MenuItem Header="終了"
                          Click="Menu_File_Exit_Click"/>
            </MenuItem>
            <MenuItem Header="設定">
                <MenuItem Header="ffmpegパス設定"
                          Click="Menu_SetFfmpegPath_Click"/>
            </MenuItem>
        </Menu>


        <!-- メインUI-->
        <StackPanel Grid.Row="1"
                    Orientation="Vertical"
                    >
            <TextBlock Text="動画ファイルをここにドラッグ＆ドロップしてください"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       Height="100"
                       Margin="0,0,0,10"
                       />
            <TextBox Name="InputFileBox"
                     IsReadOnly="False"
                     TextWrapping="Wrap"
                     Height="50"
                     Margin="0,0,0,12"
                     />
            <TextBlock Text="開始時刻（hhmmss）"/>
            <TextBox Name="StartTimeBox" MaxLength="6"/>

            <TextBlock Text="Duration（秒）"/>
            <xctk:IntegerUpDown
                Name="DurationBox"
                Minimum="1"
                Maximum="3600"
                Value="5"
                />

            <Button 
                Name="ExecuteButton"
                Content="実行" 
                Margin="0,10,0,0" 
                Click="ExecuteButton_Click"
                Height="30"
                />

        </StackPanel>
    </Grid>
</Window>
