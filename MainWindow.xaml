<Window x:Class="ffmpegCutter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ffmpegCutter"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="ffmpeg Cutter" Height="520" Width="304"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        >
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--メニュー-->
        <Menu Grid.Row="0">
            <MenuItem Header="ファイル">
                <MenuItem Header="終了"
                          Click="Menu_File_Exit_Click"/>
            </MenuItem>

            <MenuItem Header="設定">
                <MenuItem Header="ffmpegパス設定"
                          Click="Menu_SetFfmpegPath_Click"/>
                <MenuItem Header="ffmpegを自動ダウンロード"
                          Click="Menu_DownloadFfmpeg_Click"/>
                <Separator/>
                <MenuItem Header="ffmpeg情報"
                          Click="Menu_ShowFfmpegInfo_Click"/>
            </MenuItem>

            <MenuItem Header="表示">
                <MenuItem 
                          x:Name="MenuTopMostItem"
                          Header="最前面に表示"
                          IsCheckable="True"
                          Click="Menu_Show_Topmost_Click"/>
                <MenuItem 
                          x:Name="MenuKeypadItem"
                          Header="テンキーを表示"
                          IsCheckable="True"
                          Click="Menu_Show_Keypad_Click"/>
            </MenuItem>
        </Menu>


        <!-- メインUI-->
        <StackPanel Grid.Row="1"
                    Orientation="Vertical"
                    >
            <TextBlock Text="動画ファイルをここにドラッグ＆ドロップしてください" Height="100" FontWeight="Bold" UseLayoutRounding="False" Margin="0,0,0,10" TextAlignment="Center"
                       />
            <TextBox Name="InputFileBox"
                     IsReadOnly="False"
                     TextWrapping="Wrap"
                     Height="50"
                     Margin="0,0,0,12"
                     />
            <TextBlock Text="開始時刻（hhmmss）"/>
            <TextBox Name="StartTimeBox" MaxLength="6"/>

            <TextBlock Text="Duration（秒）"/>
            <xctk:IntegerUpDown
                Name="DurationBox"
                Minimum="1"
                Maximum="3600"
                Value="5"
                />

            <Button 
                Name="ExecuteButton"
                Content="実行" 
                Margin="0,10,0,0" 
                Click="ExecuteButton_Click"
                Height="30"
                />
        
            <!-- テンキー -->
            <Grid x:Name="KeypadGrid"
                  Visibility="Collapsed"
                  Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- 1〜9 -->
                <Button Content="1" Grid.Row="0" Grid.Column="0" Click="Keypad_Click"/>
                <Button Content="2" Grid.Row="0" Grid.Column="1" Click="Keypad_Click"/>
                <Button Content="3" Grid.Row="0" Grid.Column="2" Click="Keypad_Click"/>

                <Button Content="4" Grid.Row="1" Grid.Column="0" Click="Keypad_Click"/>
                <Button Content="5" Grid.Row="1" Grid.Column="1" Click="Keypad_Click"/>
                <Button Content="6" Grid.Row="1" Grid.Column="2" Click="Keypad_Click"/>

                <Button Content="7" Grid.Row="2" Grid.Column="0" Click="Keypad_Click"/>
                <Button Content="8" Grid.Row="2" Grid.Column="1" Click="Keypad_Click"/>
                <Button Content="9" Grid.Row="2" Grid.Column="2" Click="Keypad_Click"/>

                <!-- 最下段 -->
                <Button Content="0" Grid.Row="3" Grid.Column="1" Click="Keypad_Click"/>
                <Button Content="←" Grid.Row="3" Grid.Column="2" Click="Keypad_Backspace_Click"/>

            </Grid>

        </StackPanel>

        <ProgressBar 
            Name="ProgressBar"
            Grid.Row="2"
            Height="20"
            Margin="0,10,0,0"
            Minimum="0"
            Maximum="100"
            Visibility="Collapsed"
            />
    </Grid>
</Window>
